{
  "info": {
    "name": "CodeBridge API",
    "description": "Import this into Postman. Set a collection variable 'token' after login to test protected routes.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:5000" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Jane Student\",\n  \"email\": \"jane@example.com\",\n  \"password\": \"password123\"\n}"
            }
          }
        },
        {
          "name": "Register - duplicate email (expect 409)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Jane Student\",\n  \"email\": \"jane@example.com\",\n  \"password\": \"password123\"\n}"
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"jane@example.com\",\n  \"password\": \"password123\"\n}"
            }
          }
        },
        {
          "name": "Login - wrong password (expect 401)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"jane@example.com\",\n  \"password\": \"wrongpass\"\n}"
            }
          }
        },
        {
          "name": "Get Profile (protected)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/api/auth/profile"
          }
        },
        {
          "name": "Get Profile - no token (expect 401)",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/auth/profile"
          }
        }
      ]
    },
    {
      "name": "Courses",
      "item": [
        {
          "name": "Get all courses (paginated)",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/courses?page=1&limit=5"
          }
        },
        {
          "name": "Search courses by title",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/courses?search=javascript"
          }
        },
        {
          "name": "Sort courses by price descending",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/courses?sort=price_desc"
          }
        },
        {
          "name": "Get course by id",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/courses/1"
          }
        },
        {
          "name": "Get course by id - not found (expect 404)",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/courses/9999"
          }
        }
      ]
    },
    {
      "name": "Enrollments",
      "item": [
        {
          "name": "Enroll in a course",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{base_url}}/api/enrollments",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"course_id\": 1\n}"
            }
          }
        },
        {
          "name": "Enroll again - duplicate (expect 409)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{base_url}}/api/enrollments",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"course_id\": 1\n}"
            }
          }
        },
        {
          "name": "Get my courses",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/api/enrollments/my-courses"
          }
        },
        {
          "name": "Drop a course",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/api/enrollments/1"
          }
        }
      ]
    }
  ]
}
